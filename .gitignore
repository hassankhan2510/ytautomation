# --- dependencies & build output ---
node_modules/
theranos-doc/node_modules/
theranos-doc/out/
theranos-doc/.remotion/

# --- generated per render (recreated by `npm run prepare-video`) ---
theranos-doc/public/audio/
theranos-doc/public/thumb/
theranos-doc/src/data/timeline.json

# --- uncompressed source-asset duplicates ---
# The COMPRESSED versions live in theranos-doc/public/assets (those ARE committed).
# This folder holds the original heavy files + is only used by the retired TheranosDoc.tsx.
theranos-doc/src/assets/

# --- secrets: never commit OAuth client files or tokens ---
theranos-doc/client_secret*.json
**/client_secret*.json
*.token
# TikTok session cookies — NEVER commit; used as a GitHub secret instead.
**/cookies.txt
**/cookies*.json

# --- os / editor / logs ---
*.log
.DS_Store
Thumbs.db
.vscode/
theranos-doc/li/

# generated one-pager background (fetched fresh each CI run)
theranos-doc/public/onepager_bg.jpg
