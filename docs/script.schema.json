{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VideoScript",
  "description": "The single per-video content file. The AI produces this; the engine renders it.",
  "type": "object",
  "required": ["meta", "lines"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "topic", "niche", "channel", "platform", "targetSeconds", "style", "voice", "accentColor", "description", "tags", "researchFile"],
      "properties": {
        "title": { "type": "string", "minLength": 8, "description": "The single BEST rank-fast, high-CTR title (see docs/TITLES.md)" },
        "titleOptions": { "type": "array", "items": { "type": "string" }, "description": "3-6 alternative rank-fast titles to A/B choose from" },
        "hashtags": { "type": "array", "items": { "type": "string" }, "description": "5-12 hashtags for the post (without the # is fine)" },
        "topic": { "type": "string", "minLength": 8 },
        "niche": { "type": "string", "enum": ["space", "business", "ai", "finance", "history", "truecrime", "science", "psychology", "geography", "motivation"] },
        "channel": { "type": "string", "minLength": 2 },
        "platform": { "type": "string", "enum": ["youtube-long", "shorts", "reel", "linkedin"] },
        "targetSeconds": { "type": "integer", "minimum": 15 },
        "fps": { "type": "integer", "default": 30 },
        "style": { "type": "string" },
        "voice": { "type": "string", "description": "Edge TTS voice id, or cloned voice id later" },
        "voiceRate": { "type": "string", "default": "+10%", "description": "Speech speed, e.g. \"+18%\" for snappy reels, \"+10%\" for long-form, \"+0%\" for slow." },
        "pauseBetweenLinesSec": { "type": "number", "default": 0.25, "description": "Gap between scenes. ~0.15 for fast reels, ~0.25 for long-form." },
        "music": { "type": ["string", "null"], "description": "Optional filename in public/music/ (a calm/cinematic royalty-free bed). Omit for no music." },
        "musicVolume": { "type": "number", "default": 0.14, "description": "Background music level, 0-1. Keep low (~0.10-0.18) so it sits under the voice." },
        "accentColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "description": { "type": "string", "minLength": 20 },
        "tags": { "type": "array", "items": { "type": "string" }, "minItems": 3 },
        "researchFile": { "type": "string", "description": "Path (relative to script.json) to the research.md used to write this script" },
        "requireResearch": { "type": "boolean", "default": true }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "keywords", "type"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "description": "What is SPOKEN (TTS). May be Hindi/Urdu." },
          "caption": { "type": ["string", "null"], "description": "What is SHOWN on screen (English). Defaults to text. REQUIRED when voice is not English." },
          "keywords": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "asset": { "type": ["string", "null"] },
          "type": { "type": "string", "enum": ["image", "video"] },
          "layout": { "type": "string", "enum": ["lower-third", "center", "title", "stat", "quote", "bullets", "chart", "compare", "timeline", "meter", "nametag", "map", "collage"], "default": "lower-third" },
          "kicker": { "type": ["string", "null"], "description": "Short label above text; also the heading for a bullets/chart scene" },
          "stat": { "type": ["string", "null"], "description": "layout=stat: the big figure, e.g. \"$9,000,000,000\"" },
          "cite": { "type": ["string", "null"], "description": "layout=quote: the attribution line" },
          "items": { "type": ["array", "null"], "items": { "type": "string" }, "description": "layout=bullets: the list items (2-5)" },
          "chart": { "type": ["array", "null"], "items": { "type": "object", "properties": { "label": { "type": "string" }, "value": { "type": "number" } } }, "description": "layout=chart: bars, 2-6 of {label,value}" },
          "compare": { "type": ["object", "null"], "properties": { "left": { "type": "object" }, "right": { "type": "object" } }, "description": "layout=compare: { left:{title,items[]}, right:{title,items[]} }" },
          "events": { "type": ["array", "null"], "items": { "type": "object", "properties": { "label": { "type": "string" }, "text": { "type": "string" } } }, "description": "layout=timeline: 2-6 of {label,text}" },
          "percent": { "type": ["number", "null"], "description": "layout=meter: 0-100" },
          "name": { "type": ["string", "null"], "description": "layout=nametag: person name" },
          "role": { "type": ["string", "null"], "description": "layout=nametag: title/role under the name" },
          "location": { "type": ["string", "null"], "description": "layout=map: place name" },
          "coords": { "type": ["string", "null"], "description": "layout=map: coordinates string" },
          "collageAssets": { "type": ["array", "null"], "items": { "type": "string" }, "description": "layout=collage: 2-4 asset filenames from public/assets" }
        }
      }
    }
  }
}
