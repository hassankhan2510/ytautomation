{
  "name": "theranos-doc",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.500",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.500",
    "@remotion/tailwind-v4": "4.0.500",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.500",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "validate": "node scripts/validate.mjs",
    "voiceover": "python scripts/gen_voiceover.py",
    "assets": "node scripts/fetch_assets.mjs",
    "compress": "node scripts/compress_assets.mjs",
    "make-sfx": "node scripts/make_sfx.mjs",
    "autocut": "node scripts/autocut.mjs",
    "batch": "node scripts/batch.mjs",
    "kit": "node scripts/publish_kit.mjs",
    "generate": "node scripts/generate_script.mjs",
    "prepare-video": "node scripts/validate.mjs && python scripts/gen_voiceover.py && node scripts/fetch_assets.mjs && node scripts/compress_assets.mjs && node scripts/make_sfx.mjs",
    "render:youtube": "remotion render YouTube out/video.mp4 --concurrency=4",
    "render:shorts": "remotion render Shorts out/shorts.mp4 --concurrency=4",
    "render:square": "remotion render Square out/square.mp4 --concurrency=4",
    "preview:youtube": "remotion render YouTube out/preview.mp4 --scale=0.5 --concurrency=4 --jpeg-quality=70",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}